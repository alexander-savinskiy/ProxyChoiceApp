<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ProxyChoicePro</AssemblyName>
    <RootNamespace>ProxyChoiceApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Version>1.1.3</Version>
    <Description>Application proxies and work network VPN for Windows</Description>
    <Authors>Alexander Savinskiy</Authors>
    <Copyright>© 2026 Alexander Savinskiy · a.savinskiy@gmail.com</Copyright>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/*.ico" />
    <Resource Include="Assets/Flags/*.png" />
    <EmbeddedResource Include="Localization/*.json" />
    <EmbeddedResource Include="../../docs/work-client.example.conf" LogicalName="ProxyChoiceApp.import-template.conf" />
    <EmbeddedResource Include="../../vendor/singbox.zip" LogicalName="ProxyChoiceApp.engine.zip" />
    <EmbeddedResource Include="../../THIRD-PARTY-NOTICES.txt" LogicalName="ProxyChoiceApp.notices.txt" />
    <EmbeddedResource Include="../../vendor/engine-manifest.json" LogicalName="ProxyChoiceApp.engine-manifest.json" />
    <InternalsVisibleTo Include="ProxyChoiceApp.Tests" />
  </ItemGroup>
</Project>
