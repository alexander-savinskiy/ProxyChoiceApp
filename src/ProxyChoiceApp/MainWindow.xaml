<Window x:Class="ProxyChoiceApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ProxyChoiceApp.Localization" Title="ProxyChoicePro" Width="1080" Height="830" MinWidth="760" MinHeight="600" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" SizeChanged="Window_SizeChanged">
 <Window.TaskbarItemInfo><TaskbarItemInfo/></Window.TaskbarItemInfo>
 <Border BorderBrush="{DynamicResource Frame}" BorderThickness="1.5" Background="{DynamicResource Canvas}"><Grid Margin="20,16,20,12">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ProxyChoicePro" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr ProTagline}" Style="{StaticResource Hint}" Margin="0,4,15,0"/></StackPanel><StackPanel Grid.Column="1"><ComboBox x:Name="LanguagePicker" Width="200" SelectedValuePath="Code" SelectionChanged="Language_Changed" AutomationProperties.Name="{loc:Tr Language}"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Flag}" Width="26" Height="17" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><CheckBox x:Name="DarkModeBox" Content="{loc:Tr DarkMode}" Checked="Theme_Changed" Unchecked="Theme_Changed" Margin="0,6,0,0"/></StackPanel></Grid>
 <Border x:Name="Notice" Grid.Row="1" Visibility="Collapsed" CornerRadius="8" Padding="12,8" Margin="0,0,0,10"><DockPanel><Button DockPanel.Dock="Right" Content="×" ToolTip="{loc:Tr Dismiss}" Click="DismissNotice_Click" Padding="8,0" MinHeight="28" Margin="8,0,0,0"/><TextBlock x:Name="NoticeText" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
 <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,15,0"><DockPanel><Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,8,0"/><TextBlock x:Name="StatusTitle" FontSize="18" FontWeight="SemiBold"/></DockPanel><TextBlock x:Name="StatusDescription" Style="{StaticResource Hint}" Margin="0,4,0,3"/><TextBlock x:Name="ProxyIpText" Text="—" FontWeight="SemiBold"/><TextBlock x:Name="DurationText" Style="{StaticResource Hint}" FontSize="12"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,24,0" MinWidth="95"><TextBlock Text="{loc:Tr Download}" Style="{StaticResource Label}"/><TextBlock x:Name="DownloadSpeedText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DownloadTotalText" Style="{StaticResource Hint}"/></StackPanel><StackPanel Grid.Column="2" MinWidth="95"><TextBlock Text="{loc:Tr Upload}" Style="{StaticResource Label}"/><TextBlock x:Name="UploadSpeedText" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="UploadTotalText" Style="{StaticResource Hint}"/></StackPanel></Grid></Border>
 <TabControl x:Name="MainTabs" Grid.Row="3" SelectionChanged="Tabs_Changed">
 <TabItem x:Name="ConnectionTab" Header="{loc:Tr ConnectionTab}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid x:Name="ConnectionGrid"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="275"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border x:Name="ProfileCard" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,0,14"><StackPanel x:Name="ProfileControls"><TextBlock Text="{loc:Tr ConnectionProfile}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><ComboBox x:Name="ProfilePicker" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectionChanged="Profile_Changed"/><WrapPanel Margin="0,8,0,10"><Button Content="{loc:Tr Add}" Click="AddProfile_Click" Padding="10,7" Margin="0,0,6,6"/><Button Content="{loc:Tr Rename}" Click="RenameProfile_Click" Padding="10,7" Margin="0,0,6,6"/><Button x:Name="DeleteProfileButton" Content="{loc:Tr Remove}" Click="DeleteProfile_Click" Padding="10,7" Margin="0,0,0,6"/></WrapPanel><CheckBox x:Name="AutoReconnectBox" Checked="ReconnectOption_Changed" Unchecked="ReconnectOption_Changed"><TextBlock Text="{loc:Tr AutoReconnect}" TextWrapping="Wrap"/></CheckBox><TextBlock Text="{loc:Tr AutoReconnectHint}" Style="{StaticResource Hint}" Margin="0,3,0,10"/><TextBlock x:Name="ProfileHint" Style="{StaticResource Hint}"/></StackPanel></Border>
 <Border x:Name="ServerCard" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top" Margin="0,0,0,14"><StackPanel><StackPanel x:Name="ProfileForm"><TextBlock Text="{loc:Tr ConnectionMode}" Style="{StaticResource Label}"/><ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="Mode_Changed"><ComboBoxItem Content="{loc:Tr ProxyMode}"/><ComboBoxItem Content="{loc:Tr WorkMode}"/></ComboBox>
 <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{loc:Tr Server}" Style="{StaticResource Label}"/><TextBox x:Name="HostBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{loc:Tr Port}" Style="{StaticResource Label}"/><TextBox x:Name="PortBox" Text="1080" MaxLength="5"/></StackPanel></Grid>
 <StackPanel x:Name="ProxyFields"><TextBlock Text="{loc:Tr Protocol}" Style="{StaticResource Label}" Margin="0,12,0,6"/><ComboBox x:Name="ProtocolBox" SelectedIndex="0" SelectionChanged="Protocol_Changed"><ComboBoxItem Content="SOCKS5"/><ComboBoxItem Content="HTTP"/><ComboBoxItem Content="HTTPS"/></ComboBox><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Tr Username}" Style="{StaticResource Label}"/><TextBox x:Name="UsernameBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{loc:Tr Password}" Style="{StaticResource Label}"/><PasswordBox x:Name="PasswordBox"/></StackPanel></Grid><CheckBox x:Name="RememberBox" Content="{loc:Tr RememberPassword}" Margin="0,9,0,0"/><CheckBox x:Name="UdpBox" Content="{loc:Tr EnableUdp}"/></StackPanel>
 <StackPanel x:Name="WorkFields" Visibility="Collapsed"><WrapPanel Margin="0,14,0,0"><Button Content="{loc:Tr ImportWireGuard}" Click="ImportWork_Click" Margin="0,0,8,8"/><Button Content="{loc:Tr PasteWireGuard}" Click="PasteWork_Click" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="WorkProfileText" Style="{StaticResource Hint}"/><TextBlock x:Name="WorkAddressText" FontWeight="SemiBold" Margin="0,5,0,6"/><TextBlock Text="{loc:Tr WorkKeyHint}" Style="{StaticResource Hint}"/><Expander Header="{loc:Tr WorkOptions}" Margin="0,12,0,0" Foreground="{DynamicResource Ink}"><StackPanel Margin="0,10,0,0"><TextBlock Text="{loc:Tr WorkRoutes}" Style="{StaticResource Label}"/><TextBox x:Name="WorkRoutesBox" Height="72" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock Text="{loc:Tr WorkRoutesHint}" Style="{StaticResource Hint}" Margin="0,5,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{loc:Tr ProbeHost}" Style="{StaticResource Label}"/><TextBox x:Name="ProbeHostBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{loc:Tr Port}" Style="{StaticResource Label}"/><TextBox x:Name="ProbePortBox" Text="80" MaxLength="5"/></StackPanel></Grid><TextBlock Text="{loc:Tr ProbeHint}" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></Expander></StackPanel></StackPanel>
 <WrapPanel Margin="0,18,0,0"><Button x:Name="ConnectButton" Style="{StaticResource Primary}" Click="Connect_Click" MinWidth="140" Margin="0,0,8,8"/><Button x:Name="SaveProfileButton" Content="{loc:Tr SaveProfile}" Click="SaveProfile_Click" Margin="0,0,8,8"/><Button x:Name="TestButton" Click="Test_Click" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border></Grid></ScrollViewer></TabItem>
 <TabItem x:Name="ComputersTab" Header="{loc:Tr ComputersTab}"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{loc:Tr ComputersHeading}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr ComputersHint}" Style="{StaticResource Hint}" Margin="0,5,0,15"/><ListBox x:Name="ComputersList" ItemsSource="{Binding RemoteComputers}" MinHeight="90" MaxHeight="230" SelectionChanged="Computer_Changed"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/><TextBlock Grid.Column="1" Text="{Binding Endpoint}" Foreground="{DynamicResource Muted}" Margin="16,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="{loc:Tr ComputerName}" Style="{StaticResource Label}" Margin="0,15,0,6"/><TextBox x:Name="ComputerNameBox"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{loc:Tr ComputerIp}" Style="{StaticResource Label}"/><TextBox x:Name="ComputerHostBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{loc:Tr Port}" Style="{StaticResource Label}"/><TextBox x:Name="ComputerPortBox" Text="3389" MaxLength="5"/></StackPanel></Grid><TextBlock Text="{loc:Tr RdpUsername}" Style="{StaticResource Label}" Margin="0,12,0,6"/><TextBox x:Name="ComputerUserBox"/><WrapPanel Margin="0,15,0,0"><Button Content="{loc:Tr NewComputer}" Click="NewComputer_Click" Margin="0,0,8,8"/><Button Content="{loc:Tr SaveComputer}" Click="SaveComputer_Click" Margin="0,0,8,8"/><Button Content="{loc:Tr Remove}" Click="RemoveComputer_Click" Margin="0,0,8,8"/><Button Content="{loc:Tr OpenRdp}" Style="{StaticResource Primary}" Click="OpenRdp_Click" Margin="0,0,8,8"/><Button Content="{loc:Tr CheckRdp}" Click="CheckRdp_Click" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border></ScrollViewer></TabItem>
 <TabItem x:Name="AppsTab" Header="{loc:Tr Applications}"><Grid Margin="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="38" /><RowDefinition Height="Auto" MinHeight="38" /><RowDefinition Height="Auto" MinHeight="38" /><RowDefinition Height="*" /><RowDefinition Height="Auto" MinHeight="38" /></Grid.RowDefinitions>
            <TextBlock x:Name="AppsModeHint" Text="{loc:Tr SelectAppsHint}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
            <Border x:Name="ProxyMandatoryCard" Grid.Row="1" Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="10,7" Margin="0,0,0,7"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{loc:Tr AlwaysProxy}" Foreground="{DynamicResource Accent}" /><TextBlock Text="✓  ProxyChoicePro" FontWeight="SemiBold" /></DockPanel></Border>
            <CheckBox x:Name="StoreBox" Grid.Row="2" Content="Microsoft Store" IsChecked="True" ToolTip="{loc:Tr StoreHint}" Checked="Rules_Changed" Unchecked="Rules_Changed" Margin="3,4,0,9" />
            <ListBox Grid.Row="3" x:Name="AppsList" ItemsSource="{Binding Applications}" SelectionMode="Single" AutomationProperties.Name="{loc:Tr Applications}">
              <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding UseProxy, Mode=TwoWay}" IsEnabled="{Binding Available}" Content="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding Hint}" Style="{StaticResource Hint}" Margin="12,2,0,0" TextTrimming="CharacterEllipsis" MaxHeight="44" ToolTip="{Binding Hint}" />
              </Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="4" Margin="0,10,0,0">
              <UniformGrid x:Name="ProxyAppsButtons" Columns="3"><Button x:Name="RunningAppsButton" Content="{loc:Tr FromRunning}" Click="RunningApps_Click" Padding="5,7" Margin="0,0,4,0" /><Button Content="{loc:Tr ChooseExe}" Click="BrowseApp_Click" Padding="5,7" Margin="4,0" /><Button Content="{loc:Tr Remove}" Click="RemoveApp_Click" Padding="5,7" Margin="4,0,0,0" /></UniformGrid>
              <DockPanel Margin="0,9,0,0"><Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="{loc:Tr Apply}" Click="Apply_Click" Style="{StaticResource Primary}" Padding="16,8" Margin="12,0,0,0" /><TextBlock x:Name="SelectionSummary" Style="{StaticResource Hint}" VerticalAlignment="Center" /></DockPanel>
            </StackPanel>
          </Grid></TabItem><TabItem x:Name="DiagnosticsTab" Header="{loc:Tr DiagnosticsTab}"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{loc:Tr DiagnosticsHeading}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr DiagnosticsHint}" Style="{StaticResource Hint}" Margin="0,5,0,15"/><Button x:Name="DiagnoseButton" Content="{loc:Tr RunDiagnostics}" Click="Diagnose_Click" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,0,0,14"/><ItemsControl x:Name="DiagnosticsList" ItemsSource="{Binding DiagnosticResults}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/><TextBlock Grid.Column="1" Text="{Binding Status}" FontWeight="SemiBold" Margin="16,0,0,0"/></Grid><TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></ScrollViewer></TabItem><TabItem x:Name="LogTab" Header="{loc:Tr Log}"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10"><Button Content="{loc:Tr ClearLog}" Click="ClearLog_Click" DockPanel.Dock="Right" Margin="8,0,0,0" /><Button Content="{loc:Tr ExportLog}" Click="ExportLog_Click" DockPanel.Dock="Right" /><TextBlock Text="{loc:Tr LogHint}" Style="{StaticResource Hint}" VerticalAlignment="Center" /></DockPanel>
            <TextBox Grid.Row="1" x:Name="LogBox" Height="Auto" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" AutomationProperties.Name="{loc:Tr Log}" />
          </Grid></TabItem><TabItem x:Name="HelpTab" Header="{loc:Tr Help}"><ScrollViewer x:Name="HelpScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
            <TextBlock Text="{loc:Tr HelpHeading}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
            <ItemsControl x:Name="HelpSections"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,18"><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,7" /><TextBlock Text="{Binding Body}" FontSize="15" LineHeight="23" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Button Content="{loc:Tr ComponentLicenses}" Click="Licenses_Click" HorizontalAlignment="Left" />
          </StackPanel></ScrollViewer></TabItem></TabControl><Grid Grid.Row="4" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterCopyright" Style="{StaticResource Hint}" FontSize="14" Margin="0,0,12,0"><Run Text="© 2026 Alexander Savinskiy · "/><Hyperlink NavigateUri="mailto:a.savinskiy@gmail.com" RequestNavigate="Contact_Click" Foreground="{DynamicResource Muted}">a.savinskiy@gmail.com</Hyperlink></TextBlock><TextBlock x:Name="VersionText" Grid.Column="1" FontSize="14" Foreground="{DynamicResource Muted}"/></Grid></Grid></Border></Window>