<Window x:Class="ProxyChoiceApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ProxyChoiceApp.Localization" Title="ProxyChoiceApp" Width="1080" Height="760" MinWidth="980" MinHeight="700" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
  <Window.TaskbarItemInfo><TaskbarItemInfo /></Window.TaskbarItemInfo>
  <Grid Margin="20,16,20,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="ProxyChoiceApp" FontSize="26" FontWeight="SemiBold" /><TextBlock Text="{loc:Tr Tagline}" Style="{StaticResource Hint}" Margin="0,3,0,0" /></StackPanel>
      <ComboBox x:Name="LanguagePicker" Grid.Column="1" Width="175" SelectedValuePath="Code" SelectionChanged="Language_Changed" AutomationProperties.Name="{loc:Tr Language}">
        <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Flag}" Width="28" Height="18" Margin="0,0,10,0" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
    </Grid>
    <Border x:Name="Notice" Grid.Row="1" Visibility="Collapsed" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
      <DockPanel><Button DockPanel.Dock="Right" Content="×" ToolTip="{loc:Tr Dismiss}" Click="DismissNotice_Click" Padding="8,0" MinHeight="28" Margin="8,0,0,0" /><TextBlock x:Name="NoticeText" VerticalAlignment="Center" MaxHeight="62" /></DockPanel>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="350" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel x:Name="ProfileControls">
            <TextBlock Text="{loc:Tr ProxyProfile}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ComboBox x:Name="ProfilePicker" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectionChanged="Profile_Changed" AutomationProperties.Name="{loc:Tr ProxyProfile}" />
            <UniformGrid Columns="3" Margin="0,6,0,10"><Button Content="{loc:Tr Add}" Click="AddProfile_Click" Padding="5,7" Margin="0,0,4,0" /><Button Content="{loc:Tr Rename}" Click="RenameProfile_Click" Padding="5,7" Margin="4,0" /><Button x:Name="DeleteProfileButton" Content="{loc:Tr Remove}" Click="DeleteProfile_Click" Padding="5,7" Margin="4,0,0,0" /></UniformGrid>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ProfileForm">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0"><TextBlock Text="{loc:Tr Protocol}" Style="{StaticResource Label}" /><ComboBox x:Name="ProtocolBox" SelectedIndex="0" SelectionChanged="Protocol_Changed"><ComboBoxItem Content="SOCKS5" /><ComboBoxItem Content="HTTP" /><ComboBoxItem Content="HTTPS" /></ComboBox></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="{loc:Tr Port}" Style="{StaticResource Label}" /><TextBox x:Name="PortBox" Text="1080" MaxLength="5" AutomationProperties.Name="{loc:Tr Port}" /></StackPanel>
              </Grid>
              <TextBlock Text="{loc:Tr Server}" Style="{StaticResource Label}" Margin="0,12,0,5" /><TextBox x:Name="HostBox" AutomationProperties.Name="{loc:Tr Server}" />
              <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Tr Username}" Style="{StaticResource Label}" /><TextBox x:Name="UsernameBox" AutomationProperties.Name="{loc:Tr Username}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{loc:Tr Password}" Style="{StaticResource Label}" /><PasswordBox x:Name="PasswordBox" AutomationProperties.Name="{loc:Tr Password}" /></StackPanel></Grid>

              <CheckBox x:Name="RememberBox" Content="{loc:Tr RememberPassword}" Margin="0,9,0,0" />
              <CheckBox x:Name="UdpBox" Content="{loc:Tr EnableUdp}" Margin="0,5,0,0" />


            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="ProfileHint" Style="{StaticResource Hint}" Margin="0,0,0,10" />
            <Button x:Name="ConnectButton" Content="{loc:Tr Connect}" Style="{StaticResource Primary}" FontSize="16" Click="Connect_Click" />
            <UniformGrid Columns="2" Margin="0,8,0,0"><Button x:Name="SaveProfileButton" Content="{loc:Tr SaveProfile}" Click="SaveProfile_Click" Padding="8,8" Margin="0,0,4,0" /><Button x:Name="TestButton" Content="{loc:Tr TestProxy}" Click="Test_Click" Padding="8,8" Margin="4,0,0,0" /></UniformGrid>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
          <StackPanel>
            <DockPanel><Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="13" Height="13" Margin="0,0,9,0" Fill="#E05151" /><TextBlock x:Name="StatusTitle" FontSize="18" FontWeight="SemiBold" /></DockPanel>
            <TextBlock x:Name="StatusDescription" Style="{StaticResource Hint}" Margin="0,4,0,8" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="{loc:Tr ProxyIp}" Style="{StaticResource Label}" /><TextBlock x:Name="ProxyIpText" Text="—" FontSize="16" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="DurationText" Style="{StaticResource Hint}" Margin="0,4,0,0" /></StackPanel>
              <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="{loc:Tr Download}" Style="{StaticResource Label}" /><TextBlock x:Name="DownloadSpeedText" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="DownloadTotalText" Style="{StaticResource Hint}" Margin="0,4,0,0" /></StackPanel>
              <StackPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock Text="{loc:Tr Upload}" Style="{StaticResource Label}" /><TextBlock x:Name="UploadSpeedText" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="UploadTotalText" Style="{StaticResource Hint}" Margin="0,4,0,0" /></StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}" SelectionChanged="Tabs_Changed">
          <TabItem Header="{loc:Tr Applications}"><Grid Margin="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="{loc:Tr SelectAppsHint}" Style="{StaticResource Hint}" Margin="0,0,0,8" />
            <Border Grid.Row="1" Background="#EAF6F1" CornerRadius="8" Padding="10,7" Margin="0,0,0,7"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{loc:Tr AlwaysProxy}" Foreground="{StaticResource Accent}" /><TextBlock Text="✓  ProxyChoiceApp" FontWeight="SemiBold" /></DockPanel></Border>
            <CheckBox x:Name="StoreBox" Grid.Row="2" Content="Microsoft Store" IsChecked="True" ToolTip="{loc:Tr StoreHint}" Checked="Rules_Changed" Unchecked="Rules_Changed" Margin="3,4,0,9" />
            <ListBox Grid.Row="3" x:Name="AppsList" ItemsSource="{Binding Applications}" SelectionMode="Single" AutomationProperties.Name="{loc:Tr Applications}">
              <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding UseProxy, Mode=TwoWay}" IsEnabled="{Binding Available}" Content="{Binding Name}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding Hint}" Style="{StaticResource Hint}" Margin="12,2,0,0" TextTrimming="CharacterEllipsis" MaxHeight="44" ToolTip="{Binding Hint}" />
              </Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="4" Margin="0,10,0,0">
              <UniformGrid Columns="3"><Button x:Name="RunningAppsButton" Content="{loc:Tr FromRunning}" Click="RunningApps_Click" Padding="5,7" Margin="0,0,4,0" /><Button Content="{loc:Tr ChooseExe}" Click="BrowseApp_Click" Padding="5,7" Margin="4,0" /><Button Content="{loc:Tr Remove}" Click="RemoveApp_Click" Padding="5,7" Margin="4,0,0,0" /></UniformGrid>
              <DockPanel Margin="0,9,0,0"><Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="{loc:Tr Apply}" Click="Apply_Click" Style="{StaticResource Primary}" Padding="16,8" Margin="12,0,0,0" /><TextBlock x:Name="SelectionSummary" Style="{StaticResource Hint}" VerticalAlignment="Center" /></DockPanel>
            </StackPanel>
          </Grid></TabItem>
          <TabItem Header="{loc:Tr Log}"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10"><Button Content="{loc:Tr ClearLog}" Click="ClearLog_Click" DockPanel.Dock="Right" Margin="8,0,0,0" /><Button Content="{loc:Tr ExportLog}" Click="ExportLog_Click" DockPanel.Dock="Right" /><TextBlock Text="{loc:Tr LogHint}" Style="{StaticResource Hint}" VerticalAlignment="Center" /></DockPanel>
            <TextBox Grid.Row="1" x:Name="LogBox" Height="Auto" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" AutomationProperties.Name="{loc:Tr Log}" />
          </Grid></TabItem>
          <TabItem Header="{loc:Tr Help}"><ScrollViewer x:Name="HelpScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
            <TextBlock Text="{loc:Tr HelpHeading}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
            <ItemsControl x:Name="HelpSections"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,18"><TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,7" /><TextBlock Text="{Binding Body}" FontSize="15" LineHeight="23" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Button Content="{loc:Tr ComponentLicenses}" Click="Licenses_Click" HorizontalAlignment="Left" />
          </StackPanel></ScrollViewer></TabItem>
        </TabControl>
      </Grid>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock DockPanel.Dock="Right" FontSize="14"><Hyperlink NavigateUri="mailto:A.savinskiy@gmai.com" RequestNavigate="Contact_Click">© 2026 Alexander Savinskiy · A.savinskiy@gmai.com</Hyperlink></TextBlock><TextBlock x:Name="FooterMode" Text="{loc:Tr Footer}" Style="{StaticResource Hint}" /></DockPanel>
  </Grid>
</Window>
